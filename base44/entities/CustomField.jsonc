{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string",
      "description": "Board this field belongs to"
    },
    "label": {
      "type": "string",
      "description": "Field label"
    },
    "key": {
      "type": "string",
      "description": "Unique field key"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "date",
        "select",
        "checkbox"
      ],
      "default": "text",
      "description": "Field type"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Options for select fields"
    },
    "position": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "board_id",
    "label",
    "key",
    "type"
  ]
}